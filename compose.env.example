# 复制为本地未跟踪文件后再使用：
# cp compose.env.example compose.env

# 监听地址与宿主机端口
# 默认只绑定本机回环，生产环境推荐由宝塔/Nginx/Caddy/云负载均衡反代到该端口。
# 如果确需直接暴露给局域网/公网，可改为 0.0.0.0，但请先确认防火墙和访问控制。
MIEMIE_HOST_BIND=127.0.0.1
MIEMIE_HOST_PORT=8000
# 安装器会固定部署镜像标签；手工部署通常保留默认值即可。
MIEMIE_IMAGE=miemie-studio:local

# 平台实例标识，用于 Webhook 事件和运维记录。仅使用字母、数字、点、冒号、下划线和短横线。
MIEMIE_INSTANCE_ID=miemie-studio
# 安装器会生成 32 字节 URL-safe Base64 密钥；手工部署必须替换此占位值。
# 丢失该密钥不会影响普通业务数据，但会使已保存的 OSS/Webhook 运维凭证无法解密。
MIEMIE_PLATFORM_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key

# Gunicorn worker 数量
MIEMIE_WORKERS=2

# 运行中版本标识，建议在每次部署前写入：
# export MIEMIE_RUNTIME_GIT_COMMIT=$(git rev-parse HEAD)
MIEMIE_RUNTIME_GIT_COMMIT=replace-with-git-commit

# 如果需要跨域访问（例如前后端分离或外部域名访问 API），按需填写
MIEMIE_CORS_ORIGINS=

# Redis：Compose 默认启用，用于 session、限流和短缓存基础设施。
# 如需临时回退文件 session / 内存限流，可在本地 compose.env 中清空这两项并移除 redis 依赖后重启。
MIEMIE_REDIS_URL=redis://redis:6379/0
MIEMIE_RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
MIEMIE_REDIS_KEY_PREFIX=miemie

# 后台任务：Compose 生产模式默认将图片工作室生成入队到 Celery worker。
MIEMIE_TASK_DISPATCHER=celery
MIEMIE_CELERY_BROKER_URL=redis://redis:6379/2
MIEMIE_CELERY_RESULT_BACKEND=redis://redis:6379/3
MIEMIE_WORKER_CONCURRENCY=1
MIEMIE_OPS_WORKER_CONCURRENCY=1
# 图片工作室生成任务 stale 兜底，默认 1800 秒；服务器验收可临时调低到 90。
MIEMIE_STUDIO_GENERATION_STALE_SECONDS=1800

# PostgreSQL：新安装默认作为唯一业务主数据源，容器启动时会先自动执行 Alembic migration。
MIEMIE_POSTGRES_DB=miemie
MIEMIE_POSTGRES_USER=miemie
# 真实 compose.env 必须改成强密码，不提交真实值。
MIEMIE_POSTGRES_PASSWORD=replace-with-strong-password
# 小内存服务器的保守默认值；后续可按资源与压测结果调整。
MIEMIE_POSTGRES_SHARED_BUFFERS=128MB
MIEMIE_POSTGRES_MAX_CONNECTIONS=50
MIEMIE_POSTGRES_WORK_MEM=4MB
MIEMIE_POSTGRES_MAINTENANCE_WORK_MEM=64MB

# PostgreSQL-only 运行策略。升级旧部署前请先按迁移手册完成备份和数据核对。
MIEMIE_DATABASE_ENABLED=true
MIEMIE_DATABASE_URL=postgresql+psycopg://miemie:${MIEMIE_POSTGRES_PASSWORD}@postgres:5432/miemie
MIEMIE_DATABASE_WRITE_MODE=postgres
MIEMIE_DATABASE_READ_MODE=postgres
MIEMIE_DATABASE_DUAL_WRITE_DOMAINS=
MIEMIE_DATABASE_PRIMARY_WRITE_DOMAINS=
MIEMIE_DATABASE_READ_DOMAINS=
MIEMIE_DATABASE_JSON_FALLBACK_READ=false
MIEMIE_DATABASE_JSON_ARCHIVE_WRITES=false
MIEMIE_DATABASE_RECONCILE_STRICT=true

# 容器时区
TZ=Asia/Shanghai
